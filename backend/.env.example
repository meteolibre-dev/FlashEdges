# FlashEdges Backend Environment Variables
# Copy this file to .env and modify as needed (used only for local dev).

# ============================================
# GCP
# ============================================
GCP_SOURCE_BUCKET=eumetsat_mtg_preprocess
GCP_SOURCE_PREFIX=inference_h5_global
GCP_DEST_BUCKET=inference_result_flashedges_forecast
GCP_DEST_PREFIX=forecasts
# Path to a service-account JSON key (optional on Cloud Run, which uses the
# job's service account via the metadata server).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
GCP_PROJECT_ID=meteoforecast

# ============================================
# Model
# ============================================
# Local path to cached model weights (downloaded from GCS at startup).
MODEL_PATH=/tmp/flashedges_cache/model.safetensors
# GCS path to model weights (downloaded at job startup if MODEL_PATH missing).
MODEL_GCS_PATH=gs://eumetsat_mtg_preprocess/assets/flashedges_v1.safetensors

# Config key in meteolibre_model/config/configs.yml.
#   v1/v2: residual: true  | v3/v4: residual: false
CONFIG_NAME=model_v4_global_satellite_metar

PATCH_SIZE=129
DENOISING_STEPS=32
BATCH_SIZE=64
FORECAST_STEPS=24
NB_FORECAST=3
CONTEXT_FRAMES=4
INTERPOLATION=linear
SAMPLER=sde
SDE_EPS=0.1
SDE_EPS_SCHEDULE=t2
INFERENCE_SEED=128

# ============================================
# Cache
# ============================================
CACHE_DIR=/tmp/flashedges_cache
LOG_LEVEL=INFO
